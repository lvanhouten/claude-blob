{
  "name": "claude-blob",
  "version": "1.0.0",
  "description": "A little desktop blob that reacts to Claude Code hooks",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "demo": "node demo.js",
    "test": "node --test \"test/*.test.mjs\"",
    "capture": "electron tools/capture.js",
    "package": "electron-packager . claude-blob --platform=win32 --arch=x64 --out=dist --overwrite \"--ignore=^/(?!(main\\.js|preload\\.js|index\\.html|gallery\\.html|style\\.css|package\\.json|src|node_modules)(/|$))\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.0.0"
  }
}
