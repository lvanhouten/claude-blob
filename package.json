{
  "name": "claude-blob",
  "version": "1.0.3",
  "description": "A little desktop blob that reacts to Claude Code hooks",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "demo": "node demo.js",
    "test": "node --test \"test/*.test.mjs\"",
    "capture": "electron tools/capture.js",
    "dist": "electron-builder --publish never"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "electron-updater": "^6.8.11",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.lvanhouten.claude-blob",
    "productName": "Claude Blob",
    "files": [
      "main.js",
      "preload.js",
      "hook.js",
      "claude-hooks.js",
      "index.html",
      "gallery.html",
      "color.html",
      "style.css",
      "src/**/*",
      "assets/**/*",
      {
        "from": "node_modules/three/examples/jsm",
        "to": "node_modules/three/examples/jsm"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "lvanhouten",
        "repo": "claude-blob"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "artifactName": "${name}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": "universal"
        },
        {
          "target": "zip",
          "arch": "universal"
        }
      ],
      "icon": "assets/icon.png",
      "identity": null,
      "category": "public.app-category.utilities",
      "extendInfo": {
        "LSUIElement": true
      },
      "artifactName": "${name}-${version}-mac.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Utility",
      "artifactName": "${name}-${version}.${ext}"
    }
  }
}
